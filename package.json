{
  "name": "patternjs",
  "version": "0.1.0",
  "description": "Human-readable pattern-matching system",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "jest --watch",
    "lint": "prettier --check .",
    "format": "prettier --write ."
  },
  "keywords": [
    "pattern",
    "regex",
    "text-matching",
    "human-readable"
  ],
  "author": "Rehuel Lobato de Mesquita (stretsh@gmail.com)",
  "license": "Apache-2.0",
  "devDependencies": {
    "jest": "^29.7.0",
    "prettier": "^3.0.0"
  },
  "jest": {
    "testEnvironment": "node"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "trailingComma": "es5",
    "printWidth": 80
  }
